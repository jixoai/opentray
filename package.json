{
  "name": "opentray-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "openspec:vision": "bun run scripts/openspec/vision-driven.ts",
    "openspec:vision2": "bun run scripts/openspec/vision2-driven.ts",
    "test:openspec:vision": "bun test scripts/openspec/vision-driven.test.ts",
    "test:openspec:vision2": "bun test scripts/openspec/vision2-driven.test.ts",
    "packages:list": "pnpm -r list --depth -1",
    "create-opentray": "bun run packages/create/src/bin.ts",
    "create-opentray:dist": "node packages/create/dist/bin.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "npm:cp-bin": "bun run scripts/binaries/cp-bin.ts",
    "npm:cp-bin:runtime": "bun run scripts/binaries/cp-bin.ts --kind runtime",
    "npm:cp-bin:webview": "bun run scripts/binaries/cp-bin.ts --kind webview",
    "prepare:linked-consumer": "pnpm -r --filter @opentray/spec --filter @opentray/packaging --filter opentray --filter @opentray/ext-webview --filter @opentray/vite-plugin run build && bun run scripts/binaries/cp-bin.ts --target debug",
    "release": "changeset publish",
    "release:alpha": "changeset publish --tag alpha --no-git-tag",
    "npm:bootstrap-package": "bun run scripts/npm/bootstrap-package.ts",
    "protocol-tags:apply": "bun run scripts/npm/protocol-dist-tags.ts --apply",
    "protocol-tags:dry-run": "bun run scripts/npm/protocol-dist-tags.ts",
    "setup:env": "bun run scripts/npm/setup-env.ts",
    "test:npm": "bun test scripts/npm",
    "trusted-publish:check": "bun run scripts/npm/configure-trusted-publish.ts --check",
    "trusted-publish:configure": "bun run scripts/npm/configure-trusted-publish.ts",
    "trusted-publish:dry-run": "bun run scripts/npm/configure-trusted-publish.ts --dry-run",
    "verify": "bun test scripts/openspec/vision-driven.test.ts scripts/openspec/vision2-driven.test.ts scripts/npm && bun test scripts/binaries && openspec schema validate vision-driven && openspec schema validate vision2 && cargo test && pnpm run typecheck && pnpm run test && pnpm -r list --depth -1",
    "verify:packed-consumer": "bun run scripts/binaries/verify-packed-consumer.ts",
    "version-packages": "changeset version",
    "version-packages:alpha": "changeset version --snapshot alpha"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@fission-ai/openspec": "1.3.1",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.19.0",
    "pnpm": ">=10.22.0"
  },
  "packageManager": "pnpm@10.22.0"
}
