{
  "name": "opentray-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "openspec:vision": "bun run scripts/openspec/vision-driven.ts",
    "test:openspec:vision": "bun test scripts/openspec/vision-driven.test.ts",
    "packages:list": "pnpm -r list --depth -1",
    "verify": "bun test scripts/openspec/vision-driven.test.ts && openspec schema validate vision-driven && pnpm -r list --depth -1"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.22.0",
    "bun": ">=1.3.0"
  }
}
