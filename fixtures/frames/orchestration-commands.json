  {
    "name": "set-webview-layout toolbar column",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "set-webview-layout",
      "windowId": "win-1",
      "layout": {
        "layers": [
          {
            "root": {
              "dir": "column",
              "gap": 1,
              "children": [
                { "id": "toolbar", "height": 44 },
                { "id": "content", "flex": 1 }
              ]
            }
          }
        ]
      }
    }
  },
  {
    "name": "set-webview-layout layered box ring",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "set-webview-layout",
      "windowId": "win-1",
      "layout": {
        "layers": [
          { "root": { "id": "content", "flex": 1 } },
          {
            "root": {
              "kind": "box",
              "id": "ring",
              "width": 800,
              "height": 600,
              "border": { "width": 2, "color": "#333333AA" },
              "cornerRadius": 8,
              "background": "#00000000"
            }
          }
        ]
      }
    }
  },
  {
    "name": "set-webview-layout explicit webview kind and hidden layer",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "set-webview-layout",
      "windowId": "win-1",
      "layout": {
        "layers": [
          { "root": { "kind": "webview", "id": "content", "flex": 1 } },
          { "root": { "id": "banner", "height": 24 }, "visible": false }
        ]
      }
    }
  },
  {
    "name": "update-webview-layout sizing patch",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "update-webview-layout",
      "windowId": "win-1",
      "viewId": "toolbar",
      "patch": { "height": 48, "minHeight": 32, "maxHeight": 64 }
    }
  },
  {
    "name": "subscribe-webview-events",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "subscribe-webview-events",
      "windowId": "win-1",
      "webviewId": "content",
      "kinds": ["urlChange", "titleChange", "focused", "geometryChange"]
    }
  },
  {
    "name": "unsubscribe-webview-events",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "unsubscribe-webview-events",
      "windowId": "win-1",
      "webviewId": "content",
      "kinds": ["urlChange", "titleChange"]
    }
  },
  {
    "name": "webview-ack echoes the command",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "webview-ack",
      "command": "navigate-webview"
    }
  },
  {
    "name": "get-webview-favicon",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "get-webview-favicon",
      "windowId": "win-1",
      "webviewId": "content"
    }
  },
  {
    "name": "set-webview-navigation-rules",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "set-webview-navigation-rules",
      "windowId": "win-1",
      "webviewId": "content",
      "rules": [{ "pattern": "*://*.tracker.example/*", "action": "block" }]
    }
  },
  {
    "name": "create-webview with favicon and navigation rules",
    "frame": {
      "owner": { "appId": "app-1", "trayId": "tray-1", "sessionId": "session-1" },
      "type": "create-webview",
      "windowId": "win-1",
      "webviewId": "content",
      "url": "https://example.org",
      "favicon": true,
      "navigationRules": [{ "pattern": "*://*.tracker.example/*", "action": "block" }]
    }
  },
  {
    "name": "get-webview-favicon-result returns value and seq",
