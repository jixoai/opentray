{
  "name": "opentray",
  "version": "0.1.0",
  "description": "Developer-facing OpenTray SDK and CLI package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/opentray"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "example:basic": "bun run examples/basic-surface.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentray/spec": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@opentray/darwin-arm64": "workspace:*",
    "@opentray/darwin-x64": "workspace:*",
    "@opentray/linux-arm64": "workspace:*",
    "@opentray/linux-x64": "workspace:*",
    "@opentray/windows-arm64": "workspace:*",
    "@opentray/windows-x64": "workspace:*"
  }
}
