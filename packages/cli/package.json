{
  "name": "opentray",
  "version": "0.14.0",
  "description": "Developer-facing OpenTray SDK and CLI package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/opentray"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opentray": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts",
    "cli": "bun run src/cli.ts",
    "example:matrix": "bun run examples/example-matrix.ts",
    "example:basic": "bun run examples/basic-tray.ts",
    "example:first-app": "bun run examples/first-app.ts",
    "example:debug-runtime-lynx": "bun run examples/debug-runtime-lynx.ts",
    "example:debug-runtime-tray": "bun run examples/debug-runtime-tray.ts",
    "example:download": "bun run examples/download-panel.ts",
    "example:mediaQuery": "bun run examples/media-query-panel.ts",
    "example:badge": "bun run examples/badge-panel.ts",
    "example:placement": "bun run examples/placement-panel.ts",
    "example:tray-panel": "bun run examples/tray-panel.ts",
    "example:webview-control": "bun run examples/webview-control.ts",
    "example:win32-bug": "bun run examples/win32-bug.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentray/spec": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@opentray/darwin-arm64": "workspace:*",
    "@opentray/darwin-x64": "workspace:*",
    "@opentray/linux-arm64": "workspace:*",
    "@opentray/linux-x64": "workspace:*",
    "@opentray/windows-arm64": "workspace:*",
    "@opentray/windows-x64": "workspace:*"
  }
}
