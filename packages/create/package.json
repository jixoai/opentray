{
  "name": "create-opentray",
  "version": "0.21.0",
  "description": "Turn any start command that serves HTTP locally into an OpenTray-hosted desktop app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/opentray"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-opentray": "./dist/bin.mjs"
  },
  "files": [
    "README.md",
    "assets",
    "dist",
    "skill"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm --filter @create-opentray/core build && pnpm --filter @create-opentray/cli build && pnpm --filter @opentray/create-webui build && tsdown src/index.ts src/bin.ts --format esm --dts && node scripts/copy-webui.mjs && node scripts/copy-core-assets.mjs && node scripts/copy-skill.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentray/packaging": "workspace:*",
    "@opentray/spec": "workspace:*",
    "@opentray/vite-plugin": "workspace:*",
    "sharp": "^0.33.5",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "ghostty-web": "^0.4.0",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "@create-opentray/core": "workspace:*",
    "@create-opentray/cli": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
