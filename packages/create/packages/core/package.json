{
  "name": "@create-opentray/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapter-neutral create-opentray Core: v1 configuration authority, registration layout, deterministic plan/apply, process ownership, observation capabilities, icon sampling, and export planning.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts && node scripts/copy-assets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentray/packaging": "workspace:*",
    "@opentray/spec": "workspace:*",
    "@opentray/vite-plugin": "workspace:*",
    "decode-ico": "^0.4.1",
    "node-html-parser": "^9.0.1",
    "sharp": "^0.33.5",
    "shell-quote": "^1.10.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.1.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
