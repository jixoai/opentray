    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.2.1",
    "sharp": "^0.33.5",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0",
    "vite-imagetools": "^12.0.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
