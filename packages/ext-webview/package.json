{
  "name": "@opentray/ext-webview",
  "version": "0.12.0",
  "description": "Official OpenTray rich popup extension backed by platform WebView engines.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/opentray"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "platforms",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "example:webview": "bun run examples/webview-command.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "opentray": ">=0.0.0"
  },
  "optionalDependencies": {
    "@opentray/ext-webview-darwin-arm64": "workspace:*",
    "@opentray/ext-webview-darwin-x64": "workspace:*",
    "@opentray/ext-webview-windows-arm64": "workspace:*",
    "@opentray/ext-webview-windows-x64": "workspace:*"
  },
  "devDependencies": {
    "@opentray/spec": "workspace:*",
    "opentray": "workspace:*",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
