{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@opentray/spec": ["packages/spec/src/index.ts"],
      "@opentray/packaging": ["packages/packaging/src/index.ts"],
      "@opentray/vite-plugin": ["packages/vite-plugin/src/index.ts"],
      "@opentray/tsdown-plugin": ["packages/tsdown-plugin/src/index.ts"],
      "@opentray/esbuild-plugin": ["packages/esbuild-plugin/src/index.ts"],
      "@opentray/webpack-plugin": ["packages/webpack-plugin/src/index.ts"],
      "@opentray/ext-lynx": ["packages/ext-lynx/src/index.ts"],
      "@opentray/ext-lynx/runtime": ["packages/ext-lynx/src/runtime.ts"],
      "opentray": ["packages/cli/src/index.ts"],
      "@opentray/ext-webview": ["packages/ext-webview/src/index.ts"]
    },
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
