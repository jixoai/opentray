+bool OpenTrayDebugModeEnabled(const char* mode) {
+  const char* raw = std::getenv("OPENTRAY_LYNX_DEBUG");
+  if (raw == nullptr || *raw == '\0' || mode == nullptr || *mode == '\0') {
+    return false;
+  }
+  if (std::strcmp(raw, "all") == 0) {
+    return true;
+  }
+  const size_t mode_len = std::strlen(mode);
+  const char* cursor = raw;
+  while (*cursor != '\0') {
+    while (*cursor == ',' || *cursor == ' ' || *cursor == '\t' || *cursor == '\n') {
+      cursor += 1;
+    }
+    if (*cursor == '\0') {
+      break;
+    }
+    const char* end = cursor;
+    while (*end != '\0' && *end != ',') {
+      end += 1;
+    }
+    size_t len = static_cast<size_t>(end - cursor);
+    while (len > 0 && (cursor[len - 1] == ' ' || cursor[len - 1] == '\t' || cursor[len - 1] == '\n')) {
+      len -= 1;
+    }
+    if ((len == 3 && std::strncmp(cursor, "all", 3) == 0) || (len == mode_len && std::strncmp(cursor, mode, mode_len) == 0)) {
+      return true;
+    }
+    cursor = end;
+    if (*cursor == ',') {
+      cursor += 1;
+    }
+  }
+  return false;
+}
+
+void OpenTrayDebugWriteLine(const char* line) {
+  if (line == nullptr || *line == '\0') {
+    return;
+  }
+  const char* log_path = std::getenv("OPENTRAY_LYNX_DEBUG_LOG_PATH");
+  FILE* stream = stderr;
+  if (log_path != nullptr && *log_path != '\0') {
+    stream = std::fopen(log_path, "a");
+  }
+  if (stream == nullptr) {
+    stream = stderr;
+  }
+  std::fputs(line, stream);
+  std::fputc('\n', stream);
+  std::fflush(stream);
+  if (stream != stderr) {
+    std::fclose(stream);
+  }
+}
+
+template <typename... Args>
+void OpenTrayDebugLogf(const char* mode, const char* format, Args... args) {
+  if (!OpenTrayDebugModeEnabled(mode)) {
+    return;
+  }
+  char buffer[1024];
+  std::snprintf(buffer, sizeof(buffer), format, args...);
+  OpenTrayDebugWriteLine(buffer);
+}
