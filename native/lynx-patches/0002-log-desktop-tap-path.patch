+bool IsOpenTrayDesktopTapDebugEvent(const PointerEvent& event) {
+  return event.device == PointerEvent::DeviceType::kMouse &&
+         (event.type == PointerEvent::EventType::kDownEvent ||
+          event.type == PointerEvent::EventType::kUpEvent ||
+          event.type == PointerEvent::EventType::kCancel);
+}
+
+bool IsOpenTrayDesktopTapDebugType(ClayEventType type) {
+  return type == kClayEventTypeTap || type == kClayEventTypeMouseDown ||
+         type == kClayEventTypeMouseUp || type == kClayEventTypeMouseClick;
+}
+
+const char* OpenTrayPointerEventName(PointerEvent::EventType type) {
+  switch (type) {
+    case PointerEvent::EventType::kDownEvent:
+      return "down";
+    case PointerEvent::EventType::kUpEvent:
+      return "up";
+    case PointerEvent::EventType::kMoveEvent:
+      return "move";
+    case PointerEvent::EventType::kCancel:
+      return "cancel";
+    case PointerEvent::EventType::kHoverEvent:
+      return "hover";
+    case PointerEvent::EventType::kSignalEvent:
+      return "signal";
+    case PointerEvent::EventType::kPanZoomStartEvent:
+      return "panzoom-start";
+    case PointerEvent::EventType::kPanZoomUpdateEvent:
+      return "panzoom-update";
+    case PointerEvent::EventType::kPanZoomEndEvent:
+      return "panzoom-end";
+    case PointerEvent::EventType::kUnkownEvent:
+      return "unknown";
+  }
+  return "unknown";
+}
+
+const char* OpenTrayPointerDeviceName(PointerEvent::DeviceType device) {
+  switch (device) {
+    case PointerEvent::DeviceType::kTouch:
+      return "touch";
+    case PointerEvent::DeviceType::kMouse:
+      return "mouse";
+    case PointerEvent::DeviceType::kTrackpad:
+      return "trackpad";
+  }
+  return "unknown";
+}
+
+void OpenTrayLogPointerEvent(const char* stage, const PointerEvent& event,
+                             bool consumed) {
+  std::fprintf(
+      stderr,
+      "[opentray][lynx-debug] stage=%s pointer=%s device=%s id=%d buttons=%lld consumed=%d page=(%.1f,%.1f) delta=(%.1f,%.1f)\n",
+      stage, OpenTrayPointerEventName(event.type),
+      OpenTrayPointerDeviceName(event.device), event.pointer_id,
+      static_cast<long long>(event.buttons), consumed ? 1 : 0,
+      static_cast<double>(event.position.x()),
+      static_cast<double>(event.position.y()),
+      static_cast<double>(event.delta.width()),
+      static_cast<double>(event.delta.height()));
+}
+
